VIRUSTOTAL_API_KEY=your_api_key_here
SECRET_KEY=change-this-to-a-long-random-string

# Gmail SMTP (local only — Render free blocks SMTP; use Resend there)
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your.email@gmail.com

# Resend HTTPS (Render). From must be onboarding@resend.dev until you verify a domain.
# Do NOT set RESEND_FROM to a Gmail address — Resend returns 403.
RESEND_API_KEY=
RESEND_FROM=CyberScan <onboarding@resend.dev>

# Local device testing: http://YOUR_LAN_IP:5000
# Render production: https://your-service.onrender.com  (no trailing slash)
APP_BASE_URL=http://127.0.0.1:5000

# Optional: set false only on local PCs with broken SSL (Avast). Use true on Render.
VIRUSTOTAL_SSL_VERIFY=true

# Render: one-time first-admin bootstrap (delete after creating admin)
# ADMIN_SETUP_SECRET=long-random-string
